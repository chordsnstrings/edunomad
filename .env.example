# Copy to .env and fill in. Never commit real secrets.

# Postgres connection string.
# Local: postgresql://edunomad:edunomad@localhost:5432/edunomad?schema=public
# Managed (Neon/Supabase/RDS): paste the provider's connection string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Secret used to sign admin session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="generate-a-long-random-string"

# Seed credentials for the first admin account (created by `npm run db:seed`).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="set-a-strong-password"

# Canonical public URL of the deployed site.
NEXT_PUBLIC_SITE_URL="https://edunomad.app"

# Object storage (S3-compatible: AWS S3 / Cloudflare R2 / Spaces / MinIO).
# Leave STORAGE_BUCKET unset to use the local filesystem backend in dev.
STORAGE_BUCKET=""
STORAGE_REGION="auto"
STORAGE_ENDPOINT=""              # e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Messaging — leave blank to use dev mocks.
WHATSAPP_CLOUD_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@edunomad.app"

# Claude API for SOP polishing (interface works without it via a mock).
ANTHROPIC_API_KEY=""

# Email provider (mocked when unset).
EMAIL_API_KEY=""
EMAIL_FROM=""
