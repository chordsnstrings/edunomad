# Copy to .env and fill in. Never commit real secrets.

# Postgres connection string.
# Local: postgresql://edunomad:edunomad@localhost:5432/edunomad?schema=public
# Managed (Neon/Supabase/RDS): paste the provider's connection string here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Secret used to sign admin session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET="generate-a-long-random-string"

# Seed credentials for the first admin account (created by `npm run db:seed`).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="set-a-strong-password"

# Canonical public URL of the deployed site.
NEXT_PUBLIC_SITE_URL="https://edunomad.app"
