// EduNomad — Prisma schema
// Postgres is the system of record (see CLAUDE.md §1.3 and docs/00-stack-decisions.md).
// To use a managed Postgres (Neon / Supabase / RDS) just change DATABASE_URL.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "debian-openssl-3.0.x" matches the node:22-slim
  // (Debian bookworm) runtime used on DigitalOcean — see Dockerfile.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Singleton row holding every company-specific, admin-editable setting.
/// There is always exactly one row, with id = "singleton".
model SiteSettings {
  id String @id @default("singleton")

  // ── Brand ───────────────────────────────────────────────
  companyName      String  @default("EduNomad")
  legalName        String  @default("EduNomad Ltd.")
  tagline          String  @default("Study abroad, simplified.")
  shortDescription String  @default("EduNomad helps students apply to universities abroad and complete the full journey to visa approval and arrival.")
  longDescription  String  @default("") @db.Text
  logoText         String  @default("EduNomad")
  logoUrl          String?
  faviconUrl       String?
  foundingYear     Int     @default(2024)

  // ── Default / global contact (fallback when no country match) ──
  defaultCountryCode String  @default("BD") // ISO-3166 alpha-2
  defaultPhone       String  @default("+880 1700 000000")
  defaultWhatsapp    String  @default("+880 1700 000000")
  email              String  @default("hello@edunomad.app")
  supportEmail       String  @default("support@edunomad.app")
  addressLine        String  @default("Level 5, Gulshan Avenue")
  city               String  @default("Dhaka")
  stateRegion        String  @default("Dhaka")
  postalCode         String  @default("1212")
  country            String  @default("Bangladesh")
  mapUrl             String?
  businessHours      String  @default("Sun–Thu, 10:00–18:00")

  // ── Social ──────────────────────────────────────────────
  facebookUrl          String?
  instagramUrl         String?
  linkedinUrl          String?
  youtubeUrl           String?
  twitterUrl           String?
  tiktokUrl            String?
  whatsappCommunityUrl String?

  // ── SEO ─────────────────────────────────────────────────
  siteUrl         String  @default("https://edunomad.app") // canonical base URL
  metaTitle       String  @default("EduNomad — Study abroad, simplified.")
  metaDescription String  @default("Apply to universities in Canada, the UK, Australia and Malaysia with expert counsellors. Documents, applications, GIC and visa — handled end to end.") @db.Text
  metaKeywords    String  @default("study abroad, student visa, university applications, study in canada, education consultant")
  ogImageUrl      String?
  twitterHandle   String  @default("@edunomad")
  themeColor      String  @default("#0B1A2E")

  // ── LLM SEO (llms.txt) ──────────────────────────────────
  llmsSummary String @default("") @db.Text

  // ── Analytics ───────────────────────────────────────────
  gaMeasurementId String? // G-XXXXXXX
  gtmId           String? // GTM-XXXXXXX
  plausibleDomain String?
  metaPixelId     String?

  // ── Feature toggles ─────────────────────────────────────
  showFloatingWhatsapp Boolean @default(true)
  showFloatingCall     Boolean @default(true)
  geoEnabled           Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Per-country contact numbers. The visitor's country (from IP / headers /
/// override) selects the row; falls back to SiteSettings defaults when absent.
model CountryContact {
  id          String  @id @default(cuid())
  countryCode String  @unique // ISO-3166 alpha-2, e.g. BD, IN, NP, CA
  countryName String
  flagEmoji   String  @default("")
  whatsapp    String // E.164, e.g. +8801700000000
  phone       String // E.164
  displayName String  @default("") // e.g. "Dhaka Office"
  languages   String  @default("en") // comma list for hreflang / availableLanguage
  note        String  @default("")
  enabled     Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enabled, sortOrder])
}

/// Admin accounts for the settings panel. This is a focused stand-in for the
/// full phone-OTP + RBAC system described in CLAUDE.md §6/§11 (goals G006-G011).
model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String    @default("Administrator")
  passwordHash  String
  role          String    @default("super_admin")
  totpSecret    String?
  totpEnabledAt DateTime?
  recoveryCodes String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ─────────────────────────────────────────────────────────────────────
// W0 Foundations — multi-tenant data model, event spine, audit log
// (see docs/01-data-model.md, CLAUDE.md §4/§6)
// ─────────────────────────────────────────────────────────────────────

enum Tenant {
  edunomad
  student
  agency
  service_partner
}

enum Language {
  en
  bn
  hi
  ne
}

enum UserStatus {
  active
  deactivated
  archived
}

/// All 22 roles (10 active in Phase 1; the rest reserved per CLAUDE.md §6).
enum UserRole {
  super_admin
  education_manager
  counsellor_manager
  counsellor
  operations_manager
  operations_team
  compliance
  finance
  student
  parent
  // Phase 2 — data model accommodates; UIs deferred
  agency_owner
  agency_sub_counsellor
  housing_partner
  bank_partner
  insurance_partner
  transport_partner
  sim_partner
  test_prep_partner
  pre_departure_coord
  marketing
  bd_manager
  alumni
}

/// G004 — every business-data entity inherits tenant scoping via tenantId.
model User {
  id            String     @id @default(uuid())
  tenant        Tenant
  tenantId      String
  role          UserRole
  phone         String     @unique
  email         String?    @unique
  language      Language   @default(en)
  status        UserStatus @default(active)
  createdAt     DateTime   @default(now())
  deactivatedAt DateTime?
  archivedAt    DateTime?
  // §11: 2FA available for all internal roles, mandatory for Compliance and
  // Super Admin. Staff sign in with an SMS OTP, which is a single factor — the
  // enrolment lived only on the separate AdminUser table, so the one role whose
  // sign-off carries legal weight had none.
  totpSecret    String?
  totpEnabledAt DateTime?
  recoveryCodes String[]   @default([])
  sessions      Session[]

  @@index([tenant, tenantId])
}

enum SourceCountry {
  BD
  IN
  NP
}

/// W1 — the student/customer. Profile fields are JSON, filled by the builder.
model Student {
  id                   String           @id @default(uuid())
  userId               String?          @unique
  tenantId             String           @default("edunomad")
  fullName             String?
  phone                String           @unique
  email                String?
  language             Language         @default(en)
  sourceCountry        SourceCountry    @default(BD)
  sourceAttribution    Json?
  dateOfBirth          DateTime?
  academic             Json?
  englishProficiency   Json?
  destinations         Json?
  fieldOfStudy         String?
  fieldCategory        String?
  budgetMinUsd         Int?
  budgetMaxUsd         Int?
  fundingSource        String?
  intakeTarget         Json?
  completenessPct      Int              @default(0)
  assignedCounsellorId String?
  leadScore            Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  applications         Application[]
  documents            Document[]
  visaFiles            VisaFile[]
  invoices             Invoice[]
  serviceBookings      ServiceBooking[]

  @@index([tenantId])
  @@index([assignedCounsellorId])
}

enum DestinationCountry {
  CA
  UK
  AU
  MY
}

enum DegreeLevel {
  foundation
  diploma
  bachelor
  master
  phd
}

/// W1 — a university/college and its admissions + commercial attributes.
model Institution {
  id                   String             @id @default(uuid())
  name                 String
  country              DestinationCountry
  city                 String
  tier                 Int                @default(2)
  tuitionMinUsd        Int
  tuitionMaxUsd        Int
  intakeMonths         Int[]
  englishMinIelts      Float              @default(6.0)
  englishMinDuolingo   Int                @default(105)
  englishMinPte        Int                @default(50)
  acceptsMoiLetter     Boolean            @default(false)
  postStudyWorkYears   Int                @default(0)
  scholarshipAvailable Boolean            @default(false)
  dliOrEquivalentId    String?
  submissionTier       Int                @default(2)
  admissionsEmail      String?
  portalUrl            String?
  commissionRateMinPct Float              @default(10)
  commissionRateMaxPct Float              @default(15)
  paymentTermsDays     Int                @default(45)
  active               Boolean            @default(true)
  notes                String?
  programmes           Programme[]
  applications         Application[]
  commissions          Commission[]

  // Without a natural key the catalogue seed re-inserted the whole list on
  // every deploy instead of upserting it.
  @@unique([name, country])
  @@index([country])
}

/// W1 — an offered course at an institution.
model Programme {
  id                         String        @id @default(uuid())
  institutionId              String
  institution                Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name                       String
  degreeLevel                DegreeLevel
  fieldCategory              String
  durationMonths             Int           @default(24)
  tuitionPerYearUsd          Int
  intakeMonthsSupported      Int[]
  englishMinSpecificIelts    Float?
  englishMinSpecificDuolingo Int?
  minAcademicPercentage      Float?
  active                     Boolean       @default(true)
  notes                      String?
  applications               Application[]

  @@unique([institutionId, name, degreeLevel])
  @@index([institutionId])
  @@index([fieldCategory])
}

/// W1 — a counsellor's working notes on a student (one editable note per author).
model Note {
  id           String   @id @default(uuid())
  studentId    String
  tenantId     String   @default("edunomad")
  authorUserId String
  body         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, authorUserId])
  @@index([studentId])
}

enum BookingStatus {
  scheduled
  rescheduled
  cancelled
  completed
}

/// W1 — a scheduled counsellor call with a student.
model Booking {
  id               String        @id @default(uuid())
  studentId        String
  tenantId         String        @default("edunomad")
  counsellorUserId String
  startsAt         DateTime
  durationMin      Int           @default(45)
  status           BookingStatus @default(scheduled)
  rescheduleToken  String        @unique
  createdAt        DateTime      @default(now())

  @@unique([counsellorUserId, startsAt])
  @@index([counsellorUserId, startsAt])
}

enum DocStatus {
  requested
  uploaded
  under_review
  approved
  rework_requested
  rejected
}

/// W1 — an uploaded student document (versioned; status derived/QA'd).
model Document {
  id           String    @id @default(uuid())
  studentId    String
  tenantId     String    @default("edunomad")
  documentType String
  version      Int       @default(1)
  storageKey   String
  mimeType     String
  sizeBytes    Int
  status       DocStatus @default(uploaded)
  qaResults    Json?
  reworkReason String?
  uploadedBy   String
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  // A re-upload computes version = latest + 1 with no constraint to catch a
  // concurrent second upload landing on the same number.
  @@unique([studentId, documentType, version])
  @@index([studentId, documentType])
}

enum SopStatus {
  draft
  polished
  locked
}

/// W7 — incident response record with runbook + post-incident review.
model Incident {
  id                String    @id @default(uuid())
  title             String
  severity          String    @default("sev3")
  status            String    @default("open")
  runbook           Json?
  createdByUserId   String
  resolvedAt        DateTime?
  reviewScheduledAt DateTime?
  reviewNotes       String?
  createdAt         DateTime  @default(now())
}

/// W7 — compliance training log per staff member.
model TrainingLog {
  id          String   @id @default(uuid())
  staffName   String
  topic       String
  completedAt DateTime @default(now())
}

/// W6 — SOP CMS article (block-typed, versioned, reviewed, published).
model SopArticle {
  id                String   @id @default(uuid())
  title             String
  slug              String   @unique
  category          String?
  ownerUserId       String?
  reviewerUserId    String?
  status            String   @default("draft")
  blocks            Json     @default("[]")
  version           Int      @default(1)
  publishedVersion  Int?
  publishedBlocks   Json?
  translationStatus Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// W6 — immutable SOP version snapshot for diff + history.
model SopArticleVersion {
  id        String   @id @default(uuid())
  articleId String
  version   Int
  title     String
  blocks    Json
  createdAt DateTime @default(now())

  @@index([articleId])
}

/// W6 — audit of who viewed which SOP version when (G153).
model SopView {
  id        String   @id @default(uuid())
  articleId String
  version   Int
  userId    String
  viewedAt  DateTime @default(now())

  @@index([articleId])
}

/// W2 — a student's Statement of Purpose (polished via Claude, version-controlled).
model Sop {
  id              String    @id @default(uuid())
  studentId       String    @unique
  content         String    @default("")
  version         Int       @default(1)
  status          SopStatus @default(draft)
  plagiarismScore Float?
  suggestions     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SopVersion {
  id        String   @id @default(uuid())
  sopId     String
  version   Int
  content   String
  lockedBy  String?
  createdAt DateTime @default(now())

  @@index([sopId])
}

enum ShortlistStatus {
  draft
  locked
  withdrawn
}

/// W2 — an inbound university email, matched to an application by reference_id.
model InboundEmail {
  id             String   @id @default(uuid())
  fromAddress    String
  subject        String
  body           String
  referenceId    String?
  applicationId  String?
  classified     Boolean  @default(false)
  classification String?
  receivedAt     DateTime @default(now())

  @@index([classified])
}

/// W3 — Compliance-authored regulatory bulletins (G095).
model Bulletin {
  id           String   @id @default(uuid())
  authorUserId String
  title        String
  body         String
  destination  String?
  publishedAt  DateTime @default(now())
}

/// W3 — regulator notification for misrepresentation post-sign-off (G096).
model RegulatorNotification {
  id           String   @id @default(uuid())
  authorUserId String
  visaFileId   String?
  regulator    String
  subject      String
  body         String
  createdAt    DateTime @default(now())
}

/// W3 — per-country checklist/form regulatory update record (G079).
model RegulatoryUpdate {
  id            String    @id @default(uuid())
  authorUserId  String
  destination   String
  summary       String
  effectiveDate DateTime?
  createdAt     DateTime  @default(now())
}

enum VisaDecision {
  pending
  approved
  refused
  info_requested
}

/// W3 — the visa application packet. Sole sign-off authority: Compliance (§1.12).
model VisaFile {
  id                 String             @id @default(uuid())
  applicationId      String             @unique
  studentId          String
  tenantId           String             @default("edunomad")
  destinationCountry DestinationCountry
  checklistState     Json?
  completenessPct    Int                @default(0)
  prepStartedAt      DateTime           @default(now())
  readyForSignoffAt  DateTime?
  signedOffAt        DateTime?
  signedOffBy        String?
  registrationNumber String?
  versionHash        String?
  submittedAt        DateTime?
  submissionProof    Json?
  decisionStatus     VisaDecision       @default(pending)
  decisionAt         DateTime?
  refusalReasons     Json?
  returnedForChanges Boolean            @default(false)
  returnReason       String?
  biometricsDoneAt   DateTime?
  vfsAppointmentAt   DateTime?
  passportReturnedAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  application        Application        @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  student            Student            @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([decisionStatus])
  @@index([readyForSignoffAt, signedOffAt])
}

/// W3 — immutable record of each Compliance sign-off.
model ComplianceSignOff {
  id                 String   @id @default(uuid())
  visaFileId         String
  complianceUserId   String
  registrationNumber String
  versionHash        String
  createdAt          DateTime @default(now())

  @@index([visaFileId])
}

/// W3 — RCIC/MARA/OISC registration profile per Compliance user (G099).
model RcicProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  registrationBody   String
  registrationNumber String
  validUntil         DateTime?
  createdAt          DateTime  @default(now())
}

enum SubmissionStatus {
  not_submitted
  packaged
  submitted
  acknowledged
  under_review
  info_requested
  offer_conditional
  offer_unconditional
  rejected
  withdrawn
}

/// W1/W2 — a student's application to a programme (shortlist → submission → decision).
model Application {
  id                      String           @id @default(uuid())
  studentId               String
  tenantId                String           @default("edunomad")
  programmeId             String
  institutionId           String
  shortlistStatus         ShortlistStatus  @default(draft)
  rationale               String?
  recommendedByCounsellor Boolean          @default(false)
  bucket                  String?
  submissionStatus        SubmissionStatus @default(not_submitted)
  submissionMethod        String?
  referenceId             String?          @unique
  submittedAt             DateTime?
  submissionProof         Json?
  decisionStatus          String?
  decisionAt              DateTime?
  offerUrl                String?
  conditions              Json?
  opsApproved             Boolean          @default(false)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  appDocuments ApplicationDocument[]
  student      Student               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  programme    Programme             @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  institution  Institution           @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  visaFile     VisaFile?

  @@unique([studentId, programmeId])
  @@index([studentId])
  @@index([submissionStatus])
  @@index([shortlistStatus])
}

/// W2 — which documents are packaged into which application.
model ApplicationDocument {
  applicationId String
  documentId    String
  roleInApp     String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@id([applicationId, documentId, roleInApp])
}

/// W2 — encrypted portal credentials for Tier-2 institutions.
model InstitutionCredential {
  id            String   @id @default(uuid())
  institutionId String   @unique
  portalUrl     String
  username      String
  passwordEnc   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// W5 — a QA review of a counsellor call against the 20-point rubric.
model QaReview {
  id               String   @id @default(uuid())
  counsellorUserId String
  reviewerUserId   String
  studentId        String?
  communicationId  String?
  scores           Json
  totalScore       Int
  notes            String?
  createdAt        DateTime @default(now())

  @@index([counsellorUserId])
}

/// W5 — multi-stage refund approval chain.
model Refund {
  id                String   @id @default(uuid())
  studentId         String
  requestedByUserId String
  amountLocal       Int
  currency          String   @default("BDT")
  reason            String
  stage             String   @default("requested")
  cmApprovedBy      String?
  financeApprovedBy String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([stage])
  @@index([studentId])
}

/// W5 — counsellor hiring pipeline candidate (G125).
model Candidate {
  id        String   @id @default(uuid())
  name      String
  stage     String   @default("applied")
  notes     String?
  createdAt DateTime @default(now())
}

/// W5 — scheduled counsellor training session (G126).
model TrainingSession {
  id          String   @id @default(uuid())
  topic       String
  scheduledAt DateTime
  createdAt   DateTime @default(now())
}

/// W5 — voluntary attrition / exit interview log (G133).
model ExitInterview {
  id             String   @id @default(uuid())
  counsellorName String
  reason         String
  notes          String?
  createdAt      DateTime @default(now())
}

/// W5 — 1:1 record with a fixed agenda checklist (G120).
model OneOnOne {
  id               String   @id @default(uuid())
  counsellorUserId String
  managerUserId    String
  agenda           Json?
  notes            String?
  createdAt        DateTime @default(now())
}

/// W5 — end-of-day team thread post (G130).
model TeamPost {
  id           String   @id @default(uuid())
  authorUserId String
  body         String
  createdAt    DateTime @default(now())
}

/// W5 — counsellor leave record (G127).
model LeaveRecord {
  id               String   @id @default(uuid())
  counsellorUserId String
  fromDate         DateTime
  toDate           DateTime
  reason           String?
  createdAt        DateTime @default(now())
}

/// W5 — performance improvement plan with weekly checkpoints.
model Pip {
  id               String   @id @default(uuid())
  counsellorUserId String
  managerUserId    String
  reason           String
  checkpoints      Json?
  status           String   @default("active")
  startedAt        DateTime @default(now())
}

enum InvoiceStatus {
  issued
  paid
  partially_paid
  void
  refunded
}

enum PaymentMethod {
  bkash
  nagad
  ssl
  card
  bank_transfer
}

enum PaymentStatus {
  initiated
  succeeded
  failed
  refunded
}

/// W4 — an invoice raised against a student (service fee, deposit, GIC referral…).
model Invoice {
  id          String        @id @default(uuid())
  studentId   String
  tenantId    String        @default("edunomad")
  amountLocal Int
  currency    String        @default("BDT")
  amountUsd   Int
  purpose     String
  dueDate     DateTime?
  status      InvoiceStatus @default(issued)
  createdAt   DateTime      @default(now())
  payments    Payment[]
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@index([studentId])
  @@index([status])
}

/// W4 — a payment against an invoice (platform gateways only — §1.11).
model Payment {
  id               String        @id @default(uuid())
  invoiceId        String
  tenantId         String        @default("edunomad")
  amountLocal      Int
  currency         String        @default("BDT")
  method           PaymentMethod
  externalRef      String?
  status           PaymentStatus @default(initiated)
  approvedByUserId String?
  processedAt      DateTime?
  createdAt        DateTime      @default(now())
  invoice          Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status, createdAt])
}

enum ParentInviteStatus {
  sent
  accepted
  expired
}

/// W4 — invitation linking a parent/sponsor to a student.
model ParentInvite {
  id           String             @id @default(uuid())
  studentId    String
  tenantId     String             @default("edunomad")
  parentPhone  String
  pinHash      String
  status       ParentInviteStatus @default(sent)
  parentUserId String?
  sentAt       DateTime           @default(now())
  expiresAt    DateTime?
  acceptedAt   DateTime?

  @@index([studentId])
  @@index([parentUserId])
}

enum CommType {
  call
  message
  whatsapp
  email
}

enum CommDirection {
  inbound
  outbound
}

/// W1 — calls, messages, WhatsApp threads, emails with a student.
model Communication {
  id         String        @id @default(uuid())
  studentId  String
  tenantId   String        @default("edunomad")
  userId     String?
  type       CommType
  direction  CommDirection
  content    String
  transcript String?
  language   Language      @default(en)
  metadata   Json?
  createdAt  DateTime      @default(now())

  @@index([studentId, createdAt])
}

/// W1 — counsellor metadata for routing + the assignment screen.
model CounsellorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  fullName        String
  photoUrl        String?
  languages       String[]
  destinations    String[]
  capacity        Int      @default(25)
  tenureStartedAt DateTime @default(now())
  managerId       String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

enum ActorType {
  student
  parent
  counsellor
  ops
  ops_manager
  counsellor_manager
  compliance
  finance
  education_manager
  super_admin
  system
  university
}

/// G005 — append-only, hash-chained event spine. The source of truth for
/// status timelines and the activity feed. Never updated, never deleted.
model Event {
  id            String      @id @default(uuid())
  seq           BigInt      @default(autoincrement()) // deterministic chain order
  type          String
  stage         Int
  studentId     String?
  applicationId String?
  actorType     ActorType
  actorId       String?
  visibility    Json
  channels      Json
  payload       Json
  createdAt     DateTime    @default(now())
  chainHash     String
  reads         EventRead[]

  @@index([studentId, createdAt])
  @@index([applicationId, createdAt])
  @@index([seq])
  // KPI/status queries filter the largest, never-pruned table by type (usually
  // with a date range); without these they seq-scan the whole event log.
  @@index([type, createdAt])
  @@index([studentId, type])
}

/// Mutable per-user read state — deliberately NOT part of the hash chain.
model EventRead {
  userId  String
  eventId String
  readAt  DateTime @default(now())
  event   Event    @relation(fields: [eventId], references: [id])

  @@id([userId, eventId])
}

enum AuditResult {
  success
  denied
  failed
}

/// G007 — append-only, hash-chained audit log (broader scope than events:
/// privileged actions, permission denials). Never updated, never deleted.
model AuditLog {
  id          String      @id @default(uuid())
  seq         BigInt      @default(autoincrement())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  beforeState Json?
  afterState  Json?
  ipAddress   String?
  userAgent   String?
  result      AuditResult @default(success)
  reason      String?
  createdAt   DateTime    @default(now())
  chainHash   String

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
  @@index([seq])
}

/// G008 — one OTP challenge per phone (send + verify with rate limit + lockout).
model OtpChallenge {
  id          String    @id @default(uuid())
  phone       String    @unique
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  lockedUntil DateTime?
  sendCount   Int       @default(1)
  windowStart DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// G009 — server-side session store (12h expiry; 30-min idle for internal roles).
model Session {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique
  tenant       Tenant
  role         UserRole
  isInternal   Boolean   @default(false)
  // Whether the second factor has been satisfied for THIS session. A session
  // that has only cleared the OTP must not reach a 2FA-mandatory surface.
  tfa          Boolean   @default(false)
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  lastActiveAt DateTime  @default(now())
  revokedAt    DateTime?
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// G012 — Web Push subscription (one per browser endpoint) for a user.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

enum CommissionStatus {
  expected // accrued when an offer is accepted / student enrols
  invoiced // EduNomad has billed the institution
  received // funds received from the institution
  reconciled // matched into a payout
  written_off
}

/// W4 — university commission earned by EduNomad on an application (§4 core entity).
model Commission {
  id            String           @id @default(uuid())
  tenantId      String           @default("edunomad")
  applicationId String           @unique
  institutionId String
  studentId     String?
  ratePct       Float
  amount        Int // gross commission in `currency` (whole units)
  currency      String           @default("CAD")
  amountUsd     Int // normalised to USD for reporting
  status        CommissionStatus @default(expected)
  expectedAt    DateTime?
  receivedAt    DateTime?
  reference     String?
  payoutId      String?
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  institution   Institution      @relation(fields: [institutionId], references: [id], onDelete: Restrict)

  @@index([institutionId])
  @@index([status])
  @@index([payoutId])
}

enum PayoutStatus {
  scheduled
  processing
  paid
  failed
}

/// W4 — a settlement batch grouping reconciled commissions (§4: Commission → Payouts).
model Payout {
  id               String       @id @default(uuid())
  tenantId         String       @default("edunomad")
  reference        String       @unique
  amountUsd        Int
  currency         String       @default("USD")
  status           PayoutStatus @default(scheduled)
  periodStart      DateTime?
  periodEnd        DateTime?
  approvedByUserId String?
  processedAt      DateTime?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([status])
}

enum ServiceType {
  housing
  bank
  sim
  insurance
  transport
  test_prep
}

enum ServiceBookingStatus {
  requested
  matched
  confirmed
  cancelled
}

/// W7 — a service partner (housing, bank, SIM, insurance, transport, test prep).
/// Partner-facing UIs are Phase 2 (CLAUDE.md §12); the data model carries them
/// from day one so Stage 9 bookings have something real to point at.
model ServicePartner {
  id           String             @id @default(uuid())
  tenant       Tenant             @default(service_partner)
  tenantId     String             @default("service_partner")
  name         String
  serviceType  ServiceType
  country      DestinationCountry @default(CA)
  city         String?
  contactEmail String?
  contactPhone String?
  leadTimeDays Int                @default(7)
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  bookings     ServiceBooking[]

  @@unique([name, serviceType])
  @@index([serviceType, active])
}

/// §4 core entity — a student's request for a partner service (Stage 9).
/// Stage 9 previously rendered a static checklist and persisted nothing, so a
/// student who asked for housing left no record anyone could act on.
model ServiceBooking {
  id          String               @id @default(uuid())
  tenantId    String               @default("edunomad")
  studentId   String
  serviceType ServiceType
  partnerId   String?
  status      ServiceBookingStatus @default(requested)
  notes       String?
  details     Json?
  requestedAt DateTime             @default(now())
  confirmedAt DateTime?
  cancelledAt DateTime?
  updatedAt   DateTime             @updatedAt
  student     Student              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  partner     ServicePartner?      @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  // One open request per service per student — a double-tap on "Request housing"
  // must not create two bookings for the coordinator to reconcile.
  @@unique([studentId, serviceType])
  @@index([studentId])
  @@index([status, requestedAt])
}
