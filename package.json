{
  "name": "edunomad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && prisma db seed",
    "db:harden": "node prisma/harden.mjs",
    "db:deploy": "prisma migrate deploy && node prisma/harden.mjs && node prisma/seed.mjs && node prisma/seed-catalog.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed:scenario": "node prisma/seed-team.mjs && node prisma/seed-ops.mjs && node prisma/seed-catalog.mjs && node prisma/seed-sop.mjs && node prisma/seed-scenario.mjs",
    "test": "tsc -p tsconfig.test.json && node --env-file-if-exists=.env --test --test-concurrency=1 \".test-build/tests/*.test.js\"",
    "test:e2e": "playwright test",
    "lighthouse": "npx --yes @lhci/cli@0.14.x autorun",
    "axe": "npx --yes @axe-core/cli@4.x",
    "seo:indexnow": "node scripts/indexnow.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@aws-sdk/client-s3": "^3.1062.0",
    "@aws-sdk/s3-request-presigner": "^3.1062.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "intl-messageformat": "^11.2.8",
    "jose": "^6.2.3",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
